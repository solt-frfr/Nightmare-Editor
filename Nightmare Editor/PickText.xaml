<Window x:Class="Nightmare_Editor.PickText"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nightmare_Editor"
        mc:Ignorable="d"
        Title="PickText" Height="300" Width="800" ResizeMode="NoResize" Background="Black">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Background="DarkGray">
            <Rectangle Name="TransRights" Stretch="Fill" Grid.Column="1">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Geometry="M0,0 H1 V1 H2 V2 H1 V1 H0Z" Brush="LightGray"/>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Image Name="Texture" Source="Images/plus.png" RenderOptions.BitmapScalingMode="Fant" Grid.Column="1"/>
        </Grid>
        <TextBlock FontSize="35" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"><Run Text="Pick a Destination"/><LineBreak/><Run Text="Texture"/></TextBlock>
        <TextBlock Name="Error" FontSize="15" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,0,50"><Run Text="Please select a texture."/></TextBlock>
        <ComboBox Height="25" Width="200" Name="Drop" SelectionChanged="Drop_SelectionChanged">
        </ComboBox>
        <Button Height="25" Width="200" FontWeight="Black" FontSize="15" VerticalAlignment="Bottom" Margin="0,0,0,30" Click="Accept_Click">
            Use Selected
        </Button>
    </Grid>
</Window>
